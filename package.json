{
  "name": "solar-territory-intelligence",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run lint && npm run test",
    "db:check": "node --import tsx apps/api/src/cli/db-check.ts",
    "db:migrate": "node --import tsx apps/api/src/cli/db-migrate.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:web && tsc -p tsconfig.json --noEmit",
    "typecheck:web": "npm run typecheck --workspace @solar/web",
    "test": "node scripts/run-tests.mjs",
    "build": "npm run build:web && tsc -p tsconfig.build.json",
    "build:web": "npm run build --workspace @solar/web",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @solar/web",
    "solar:test": "node --import tsx apps/api/src/cli/analyze-address.ts",
    "dev:api": "node --import tsx apps/api/src/server.ts",
    "start:api": "node --import tsx apps/api/src/server.ts"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
